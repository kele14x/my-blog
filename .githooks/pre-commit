#!/bin/sh
# Auto-fix CJK/half-width spacing in staged Markdown files with autocorrect.
# Enable once per clone:  git config core.hooksPath .githooks

command -v autocorrect >/dev/null 2>&1 || {
  echo "pre-commit: autocorrect not found (brew install autocorrect), skipping spacing fix." >&2
  exit 0
}

list=$(mktemp)
git diff --cached --name-only --diff-filter=ACM -z -- '*.md' '*.mdx' > "$list"
[ -s "$list" ] || exit 0

xargs -0 autocorrect --fix < "$list"
xargs -0 git add < "$list"