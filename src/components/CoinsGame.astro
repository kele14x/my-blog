---
import { COIN_COUNT } from '../lib/coins-game';
import { getCoinsGameMessages, resolveCoinsGameLocale, type CoinsGameLocale } from '../lib/coins-game-i18n';

interface Props {
	lang?: CoinsGameLocale;
}

const { lang = 'zh-CN' } = Astro.props;
const locale = resolveCoinsGameLocale(lang);
const messages = getCoinsGameMessages(locale);
---

<coins-game class="game" lang={locale} data-lang={locale} role="region" aria-label={messages.regionLabel}>
	<div class="game-heading">
		<h3>{messages.heading}</h3>
		<span>{messages.remainingPrefix}<strong data-remaining>{COIN_COUNT}</strong>{messages.remainingSuffix}</span>
	</div>
	<div class="setup" role="group" aria-label={messages.setupLabel}>
		<button type="button" data-action="start-human" disabled>{messages.startHuman}</button>
		<button type="button" data-action="start-computer" disabled>{messages.startComputer}</button>
	</div>
	<div class="board-scroll" tabindex="0" role="group" aria-label={messages.boardLabel}>
		<div class="coins">
			{Array.from({ length: COIN_COUNT }, (_, index) => (
				<button
					type="button"
					class="coin"
					data-coin={index}
					aria-label={messages.coinLabel(index + 1)}
					aria-pressed="false"
					disabled
				>
					{index + 1}
				</button>
			))}
		</div>
	</div>
	<p class="selection" data-selection></p>
	<p class="feedback" data-feedback role="status" aria-live="polite" aria-atomic="true"></p>
	<div class="actions">
		<button type="button" class="confirm" data-action="confirm" disabled>{messages.confirm}</button>
		<button type="button" data-action="clear" disabled>{messages.clear}</button>
	</div>
	<div class="game-status">
		<p class="turn" data-turn role="status" aria-live="polite" aria-atomic="true">{messages.turn.idle}</p>
		<div class="move-log" tabindex="0" role="log" aria-label={messages.movesLabel} aria-live="polite" aria-relevant="additions" aria-atomic="false">
			<ol data-moves></ol>
		</div>
	</div>
	<details class="help">
		<summary>{messages.helpSummary}</summary>
		<p>{messages.helpRules}</p>
		<p>{messages.helpControls}</p>
	</details>
	<noscript><p>{messages.noscript}</p></noscript>
</coins-game>

<script>
	import { INITIAL_BOARD, chooseMove, legalMoves } from '../lib/coins-game';
	import { getCoinsGameMessages } from '../lib/coins-game-i18n';

	type Player = 'human' | 'computer';
	type Phase = 'idle' | 'human' | 'thinking' | 'finished';

	class CoinsGameElement extends HTMLElement {
		#messages = getCoinsGameMessages();
		#board = INITIAL_BOARD;
		#selection = 0;
		#winner: Player | null = null;
		#moves: string[] = [];
		#feedback = '';
		#phase: Phase = 'idle';
		#computerTimer: number | undefined;

		constructor() {
			super();
			this.addEventListener('click', (event) => {
				if (!(event.target instanceof Element)) return;
				const button = event.target.closest<HTMLButtonElement>('button');
				if (!button || button.disabled) return;

				if (button.dataset.coin !== undefined) {
					this.selectCoin(Number(button.dataset.coin));
				} else if (button.dataset.action === 'confirm') {
					this.play();
				} else if (button.dataset.action === 'clear') {
					if (this.#phase !== 'human') return;
					this.#selection = 0;
					this.#feedback = '';
					this.render();
					this.focusAvailableCoin();
				} else if (button.dataset.action === 'start-human') {
					this.reset('human');
				} else if (button.dataset.action === 'start-computer') {
					this.reset('computer');
				}
			});
		}

		connectedCallback() {
			this.#messages = getCoinsGameMessages(this.dataset.lang);
			this.reset();
		}

		disconnectedCallback() {
			this.cancelComputerTurn();
		}

		cancelComputerTurn() {
			if (this.#computerTimer !== undefined) {
				window.clearTimeout(this.#computerTimer);
				this.#computerTimer = undefined;
			}
		}

		get coins() {
			return Array.from(this.querySelectorAll<HTMLButtonElement>('[data-coin]'));
		}

		reset(starter: Player | null = null) {
			this.cancelComputerTurn();
			this.#board = INITIAL_BOARD;
			this.#selection = 0;
			this.#winner = null;
			this.#moves = [];
			this.querySelector('[data-moves]')!.replaceChildren();
			this.querySelector('.move-log')!.scrollTop = 0;
			this.#feedback = '';
			this.#phase = starter === null ? 'idle' : 'human';
			if (starter === 'computer') {
				this.scheduleComputerTurn();
			} else {
				this.render();
			}
			this.querySelector('.board-scroll')!.scrollLeft = 0;
		}

		selectCoin(index: number) {
			if (this.#phase !== 'human') return;
			const selection = this.#selection ^ (1 << index);
			if (selection !== 0 && !legalMoves(this.#board).includes(selection)) {
				this.#feedback = (this.#selection & (this.#selection - 1)) !== 0
					? this.#messages.selectionLimit
					: this.#messages.adjacencyRequired;
			} else {
				this.#selection = selection;
				this.#feedback = '';
			}
			this.render();
		}

		play() {
			if (this.#phase !== 'human' || !legalMoves(this.#board).includes(this.#selection)) return;
			const hadSubmitFocus = document.activeElement === this.querySelector('[data-action="confirm"]');
			this.takeCoins(this.#selection, 'human');
			this.#selection = 0;
			this.#feedback = '';
			if (this.#winner === null) {
				this.scheduleComputerTurn();
			} else {
				this.render();
			}
			if (hadSubmitFocus) {
				this.querySelector<HTMLElement>('.board-scroll')!.focus({ preventScroll: true });
			}
		}

		scheduleComputerTurn() {
			this.#phase = 'thinking';
			this.render();
			this.#computerTimer = window.setTimeout(() => {
				this.#computerTimer = undefined;
				if (!this.isConnected || this.#phase !== 'thinking') return;
				const move = chooseMove(this.#board);
				if (move !== null) this.takeCoins(move, 'computer');
				if (this.#winner === null) this.#phase = 'human';
				this.render();
			}, 1500);
		}

		takeCoins(move: number, player: Player) {
			this.#board ^= move;
			this.#moves.push(this.#messages.move(player, this.coinNumbers(move)));
			if (this.#board === 0) {
				this.#winner = player === 'human' ? 'computer' : 'human';
				this.#phase = 'finished';
			}
		}

		coinNumbers(mask: number) {
			return this.coins.flatMap((_, index) => (mask & (1 << index)) ? [index + 1] : []);
		}

		focusAvailableCoin() {
			const target = this.coins.find((coin) => !coin.disabled)
				?? this.querySelector<HTMLButtonElement>('[data-action="start-human"]')!;
			target.focus({ preventScroll: true });
			target.scrollIntoView({ block: 'nearest', inline: 'nearest' });
		}

		render() {
			const humanTurn = this.#phase === 'human';
			let remaining = 0;
			for (const [index, coin] of this.coins.entries()) {
				const present = (this.#board & (1 << index)) !== 0;
				if (present) remaining++;
				coin.disabled = !present || !humanTurn;
				coin.dataset.removed = String(!present);
				coin.setAttribute('aria-pressed', String((this.#selection & (1 << index)) !== 0));
				coin.setAttribute('aria-label', this.#messages.coinLabel(index + 1, !present));
			}
			this.querySelector('[data-remaining]')!.textContent = String(remaining);
			this.querySelector('.board-scroll')!.setAttribute('aria-busy', String(this.#phase === 'thinking'));
			for (const button of this.querySelectorAll<HTMLButtonElement>('.setup button')) {
				button.disabled = false;
			}
			this.querySelector<HTMLButtonElement>('[data-action="confirm"]')!.disabled = !humanTurn || this.#selection === 0;
			this.querySelector<HTMLButtonElement>('[data-action="clear"]')!.disabled = !humanTurn || this.#selection === 0;
			this.querySelector('[data-selection]')!.textContent = this.#messages.selection(this.coinNumbers(this.#selection));
			this.querySelector('[data-feedback]')!.textContent = this.#feedback;

			const turn = {
				idle: this.#messages.turn.idle,
				human: this.#messages.turn.human,
				thinking: this.#messages.turn.thinking,
				finished: this.#winner === 'human'
					? this.#messages.turn.win
					: this.#messages.turn.loss,
			}[this.#phase];
			const status = this.querySelector('[data-turn]')!;
			if (status.textContent !== turn) status.textContent = turn;
			const moves = this.querySelector('[data-moves]')!;
			const log = this.querySelector('.move-log')!;
			const followLatest = moves.childElementCount < this.#moves.length
				&& log.scrollHeight - log.clientHeight - log.scrollTop <= 2;
			for (const move of this.#moves.slice(moves.childElementCount)) {
				const entry = document.createElement('li');
				entry.textContent = move;
				moves.append(entry);
			}
			if (followLatest) log.scrollTop = log.scrollHeight;
		}
	}

	customElements.define('coins-game', CoinsGameElement);
</script>

<style>
	.game {
		display: block;
		margin: 1rem 0;
		padding: 1.25rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 12px;
		background: var(--game-bg);
	}
	.game p {
		margin: 0;
		line-height: 1.65;
	}
	.game-heading, .setup, .actions {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.game-heading {
		justify-content: space-between;
		margin-bottom: 0.5rem;
	}
	[data-remaining] {
		display: inline-block;
		min-width: 2ch;
		font-variant-numeric: tabular-nums;
	}
	.game h3 {
		margin: 0;
		font-size: 1.125em;
	}
	.setup, .actions {
		margin: 1rem 0 0.5rem;
	}
	button {
		min-height: 44px;
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--game-btn-border);
		border-radius: 6px;
		background: var(--game-btn-bg);
		color: inherit;
		font: inherit;
		transition: transform 100ms ease, filter 100ms ease, box-shadow 100ms ease;
	}
	button:enabled:active {
		transform: translateY(1px);
		filter: brightness(0.9);
		box-shadow: inset 0 2px 3px rgb(0 0 0 / 18%);
		transition: none;
	}
	button:not(:disabled) {
		cursor: pointer;
	}
	button:focus-visible, .board-scroll:focus-visible, .move-log:focus-visible, summary:focus-visible {
		outline: 3px solid var(--accent);
		outline-offset: 3px;
	}
	.help {
		margin-top: 0.5rem;
		color: var(--game-help);
		font-size: 0.875em;
	}
	.help summary {
		box-sizing: border-box;
		min-height: 44px;
		padding: 0.5rem 0;
		cursor: pointer;
	}
	.help p {
		margin: 0.5rem 0;
	}
	.board-scroll {
		overflow-x: auto;
		padding: 0.5rem;
		margin: 1rem 0 0.25rem;
	}
	.coins {
		display: grid;
		grid-template-columns: repeat(12, 44px);
		gap: 8px;
		width: max-content;
	}
	.coin {
		width: 44px;
		height: 44px;
		padding: 0;
		border: 2px solid var(--coin-border);
		border-radius: 50%;
		background: var(--coin-bg);
		color: var(--coin-text);
		font-weight: 700;
	}
	.coin[aria-pressed='true'] {
		border-color: var(--accent);
		background: var(--accent);
		color: #fff;
	}
	.coin[data-removed='true'] {
		border-style: dashed;
		border-color: var(--coin-removed-border);
		background: transparent;
		color: var(--coin-removed-text);
		text-decoration: line-through;
	}
	.game .selection {
		min-block-size: 1lh;
		margin-top: 0.75rem;
	}
	.game .feedback {
		min-block-size: 2lh;
		color: var(--game-error);
	}
	[data-moves]:empty {
		display: none;
	}
	.confirm {
		border-color: var(--accent);
		background: var(--accent);
		color: #fff;
	}
	.actions button:disabled {
		border-color: var(--game-disabled-border);
		background: var(--game-disabled-bg);
		color: var(--game-disabled-text);
	}
	.game-status {
		margin: 1rem 0 0.5rem;
		padding-top: 1rem;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.turn {
		min-block-size: 2lh;
		font-weight: 700;
	}
	.move-log {
		box-sizing: border-box;
		height: 8rem;
		margin-top: 0.5rem;
		overflow-y: auto;
		scrollbar-gutter: stable;
	}
	[data-moves] {
		margin: 0;
		padding-left: 1.75rem;
		line-height: 1.65;
	}
	@media (prefers-reduced-motion: reduce) {
		button {
			transition: none;
		}
		button:enabled:active {
			transform: none;
		}
	}
	@media (max-width: 480px) {
		.game {
			padding: 0.875rem;
		}
		.game .feedback {
			min-block-size: 3lh;
		}
	}
</style>
