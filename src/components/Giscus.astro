---
interface Props {
	postId: string;
	lang: string;
}

const { postId, lang } = Astro.props;
const enabled =
	import.meta.env.PROD &&
	process.env.CF_PAGES === '1' &&
	process.env.CF_PAGES_BRANCH === 'main';
const productionOrigin = Astro.site!.origin;
---

{enabled && (
	<section id="comments" class="comments" aria-labelledby="comments-heading" hidden>
		<h2 id="comments-heading">{lang.startsWith('zh') ? '评论' : 'Comments'}</h2>
		<div
			class="giscus"
			data-production-origin={productionOrigin}
			data-repo="kele14x/my-blog"
			data-repo-id="R_kgDOVywfZA"
			data-category="Announcements"
			data-category-id="DIC_kwDOVywfZM4DLjoi"
			data-mapping="specific"
			data-term={`blog:${postId}`}
			data-strict="1"
			data-reactions-enabled="1"
			data-emit-metadata="0"
			data-input-position="top"
			data-theme="light"
			data-lang={lang}
			data-loading="lazy"
		></div>
		<script is:inline>
			(() => {
				const container = document.querySelector('#comments .giscus');
				if (window.location.origin !== container.dataset.productionOrigin) return;

				const script = document.createElement('script');
				script.src = 'https://giscus.app/client.js';
				script.async = true;
				script.crossOrigin = 'anonymous';
				for (const attribute of container.attributes) {
					if (attribute.name.startsWith('data-') && attribute.name !== 'data-production-origin') {
						script.setAttribute(attribute.name, attribute.value);
					}
				}
				container.closest('section').hidden = false;
				container.appendChild(script);
			})();
		</script>
	</section>
)}

<style>
	.comments {
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid rgb(var(--gray-light));
	}
</style>
