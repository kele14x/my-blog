---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2>
			<a href="/">{SITE_TITLE}</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<button
				type="button"
				id="theme-toggle"
				class="theme-toggle"
				aria-label="Switch theme"
				title="Switch theme"
			>
				<svg class="icon-light" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="12" cy="12" r="4"></circle>
					<path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"></path>
				</svg>
				<svg class="icon-dark" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
				</svg>
			</button>
		</div>
	</nav>
</header>
<script>
	// BaseHead restores this tab's sessionStorage choice before rendering.
	// Otherwise follow the system until the user chooses light or dark.
	// The choice survives navigation/reloads without localStorage or cookies.
	type Theme = 'light' | 'dark';

	const button = document.getElementById('theme-toggle')!;
	const root = document.documentElement;
	const darkQuery = window.matchMedia('(prefers-color-scheme: dark)');
	const initialTheme = root.dataset.theme;
	let forced: Theme | null =
		initialTheme === 'light' || initialTheme === 'dark' ? initialTheme : null;

	const resolved = (): Theme => forced ?? (darkQuery.matches ? 'dark' : 'light');

	const apply = () => {
		const theme = resolved();
		root.dataset.theme = theme;
		button.dataset.theme = theme;
		const label = theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme';
		button.setAttribute('aria-label', label);
		button.title = label;
		// Let embedded widgets (e.g. giscus comments) follow the theme.
		document.dispatchEvent(new CustomEvent('themechange'));
	};

	button.addEventListener('click', () => {
		forced = resolved() === 'dark' ? 'light' : 'dark';
		try {
			sessionStorage.setItem('theme', forced);
		} catch {
			// Keep the in-page toggle working when storage is blocked.
		}
		apply();
	});

	// Follow the system until the user picks a theme in this tab.
	darkQuery.addEventListener('change', () => {
		if (forced === null) apply();
	});

	apply();
</script>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: var(--surface);
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: rgb(var(--black));
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.internal-links {
		display: flex;
		align-items: center;
	}
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		margin-left: 0.5em;
		padding: 0.5em;
		border: none;
		border-radius: 6px;
		background: transparent;
		color: rgb(var(--gray-dark));
		cursor: pointer;
	}
	.theme-toggle:hover {
		background: rgb(var(--gray-light));
		color: rgb(var(--black));
	}
	.theme-toggle:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	/* Show the icon of the theme you would switch to: moon in light mode,
	   sun in dark mode. Before the script runs, default to the moon. */
	.theme-toggle .icon-light {
		display: none;
	}
	.theme-toggle[data-theme='dark'] .icon-dark {
		display: none;
	}
	.theme-toggle[data-theme='dark'] .icon-light {
		display: block;
	}
</style>
