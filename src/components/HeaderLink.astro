---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const subpath = pathname.match(/[^\/]+/g);
const isActive = href === pathname || href === '/' + (subpath?.[0] || '');
const label = await Astro.slots.render('default');
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<span data-text={label}><slot /></span>
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	/* Reserve the bold width up front so activating a link never
	   resizes the nav bar. The invisible bold pseudo-element sets
	   the width; the real label sits on top of it. */
	[data-text] {
		display: inline-flex;
		flex-direction: column;
		align-items: center;
	}
	[data-text]::after {
		content: attr(data-text);
		font-weight: bolder;
		height: 0;
		overflow: hidden;
		visibility: hidden;
		pointer-events: none;
		user-select: none;
	}
	a.active [data-text] {
		font-weight: bolder;
	}
	a.active {
		text-decoration: underline;
	}
</style>
