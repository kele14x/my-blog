---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: {
			post,
			translations: post.data.translationKey
				? posts
					.filter((entry) => entry.data.translationKey === post.data.translationKey)
					.map((entry) => ({ lang: entry.data.lang ?? 'en', href: `/blog/${entry.id}/` }))
				: [],
		},
	}));
}
type Props = {
	post: CollectionEntry<'blog'>;
	translations: { lang: string; href: string }[];
};

const { post, translations } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} postId={post.id} translations={translations}>
	<Content />
</BlogPost>
